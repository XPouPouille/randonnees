# --- Base de données ---
POSTGRES_USER=randonnees
POSTGRES_PASSWORD=changeme
POSTGRES_DB=randonnees

# --- Backend ---
DATABASE_URL=postgresql+psycopg2://randonnees:changeme@db:5432/randonnees
# Token simple à fournir dans le header X-Admin-Token pour ajouter/modifier/supprimer une randonnée
ADMIN_TOKEN=changeme-admin-token
# Origines autorisées en CORS (séparées par des virgules)
CORS_ORIGINS=http://localhost

# --- Frontend / fond de carte IGN ---
# "geoplateforme" = couches IGN libres (data.geopf.fr) sans clé
# "key" = utilise IGN_API_KEY pour les couches à accès restreint
IGN_MODE=geoplateforme
IGN_API_KEY=

# --- Divers ---
# Utilisé uniquement si tu republies le port dans docker-compose.yml (accès direct
# sans passer par Traefik). Avec le label Traefik en place, le site est exposé via
# le réseau Docker externe "frontend" et ce port n'est pas nécessaire.
FRONTEND_PORT=80
