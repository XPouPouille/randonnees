# --- Base de données ---
POSTGRES_USER=randonnees
POSTGRES_PASSWORD=changeme
POSTGRES_DB=randonnees

# --- Backend ---
DATABASE_URL=postgresql+psycopg2://randonnees:changeme@db:5432/randonnees
# Secret de signature des sessions (JWT). Génère une vraie valeur aléatoire en prod,
# ex: openssl rand -hex 32 - ne jamais utiliser la valeur par défaut ci-dessous.
JWT_SECRET=changeme-jwt-secret
# Origines autorisées en CORS (séparées par des virgules)
CORS_ORIGINS=http://localhost

# --- Frontend / fond de carte IGN ---
# "geoplateforme" = couches IGN libres (data.geopf.fr) sans clé
# "key" = utilise IGN_API_KEY pour les couches à accès restreint
IGN_MODE=geoplateforme
IGN_API_KEY=

# --- Frontend / fond de carte OpenCycleMap (Thunderforest) ---
# Clé gratuite : https://www.thunderforest.com/docs/apikeys/ - sans clé, la
# couche "OpenCycleMap" apparaît dans le sélecteur mais les tuiles ne se
# chargent pas.
THUNDERFOREST_API_KEY=

# --- Traefik ---
# Nom de domaine public utilisé par le label Traefik (jamais commité, reste
# uniquement dans ce .env local sur le serveur).
TRAEFIK_DOMAIN=randonnees.example.com

# --- Divers ---
# Utilisé uniquement si tu republies le port dans docker-compose.yml (accès direct
# sans passer par Traefik). Avec le label Traefik en place, le site est exposé via
# le réseau Docker externe "frontend" et ce port n'est pas nécessaire.
FRONTEND_PORT=80

# --- Backup quotidien (scripts/daily_backup.sh, cron) ---
# URL publique du site (utilisée par le script pour appeler l'API) - même
# valeur que ton domaine, ex https://randonnees.example.com.
BACKUP_SITE_URL=
# Compte utilisé par le script pour s'authentifier auprès de l'API (créé via
# la page Connexion du site comme n'importe quel autre compte).
BACKUP_ACCOUNT_EMAIL=
BACKUP_ACCOUNT_PASSWORD=
# Token GitHub avec accès en écriture uniquement au dépôt de backup ci-dessous
# (fine-grained token, scope Contents: Read and write, repo unique) - jamais
# commité, à ajouter à la main dans le .env du serveur.
GITHUB_BACKUP_TOKEN=
GITHUB_BACKUP_REPO=XPouPouille/Backup
