# Mode de fond de carte IGN : "geoplateforme" (couches libres data.geopf.fr, sans clé)
# ou "key" (utilise VITE_IGN_API_KEY, nécessaire pour certaines couches à accès restreint)
VITE_IGN_MODE=geoplateforme
VITE_IGN_API_KEY=

# Clé optionnelle pour le fond de carte OpenCycleMap (thunderforest.com/docs/apikeys)
VITE_THUNDERFOREST_API_KEY=
